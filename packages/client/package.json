{
  "name": "@alexandretorqueti/openclaw-console-client",
  "version": "0.1.0",
  "description": "Typed browser HTTP/SSE client for OpenClaw Console",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@alexandretorqueti/openclaw-console-contracts": "0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
