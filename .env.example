# Token compartilhado do Gateway. Nunca versione o valor real.
OPENCLAW_GATEWAY_TOKEN=replace-me

# Raiz usada para sugerir o workspace de novos agentes.
# O caminho deve existir no ambiente do OpenClaw Gateway, não no navegador.
OPENCLAW_AGENT_WORKSPACE_ROOT=/data/.openclaw

# Diretório persistente do OpenClaw no host. O Console o monta para preparar
# o workspace de agentes novos com o atalho `projects`.
OPENCLAW_STATE_DIR_HOST=/home/alexandre/docker/openclaw/openclaw_state

# Destino do atalho criado dentro de cada workspace novo. Este é o caminho
# visto pelos agentes no container do OpenClaw.
OPENCLAW_SHARED_PROJECTS_PATH=/data/workspace/projects

# Endpoint usado apenas para enriquecer a combo com o tamanho dos modelos locais.
OPENCLAW_OLLAMA_URL=http://127.0.0.1:11434

# Token de acesso do Console: protege todos os endpoints /api/* do BFF.
# Gere com: openssl rand -hex 24
OPENCLAW_CONSOLE_TOKEN=replace-me

# Chave de API da ElevenLabs (texto-para-voz das mensagens da IA).
# Registrada em /data/workspace/projects/agentes/devops/secrets/api-keys/README.md
ELEVENLABS_API_KEY=replace-me
