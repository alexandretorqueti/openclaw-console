{
  "name": "@alexandretorqueti/openclaw-console-server",
  "version": "0.1.0",
  "description": "Fastify BFF and static host for OpenClaw Console",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@alexandretorqueti/openclaw-console-contracts": "0.1.0",
    "@alexandretorqueti/openclaw-gateway-client": "0.1.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
