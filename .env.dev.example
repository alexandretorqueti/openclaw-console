# Copie para .env.dev.local. Nunca use o .env de produção neste Compose.
POSTGRES_USER=openclaw_dev
POSTGRES_PASSWORD=gere-uma-senha-local
POSTGRES_DB=openclaw_console_dev

# O Console dev deve apontar para um Gateway dev. Não aponte para o Gateway produtivo.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:19789
OPENCLAW_OLLAMA_URL=http://127.0.0.1:11435
OPENCLAW_GATEWAY_TOKEN=token-do-gateway-dev
OPENCLAW_CONSOLE_TOKEN=token-do-console-dev
OPENCLAW_STATE_DIR_HOST=/run/media/alexandre/12T/codigofonte/openclaw-console/.state-dev
OPENCLAW_AGENT_WORKSPACE_ROOT=/data/.openclaw-dev
OPENCLAW_SHARED_PROJECTS_PATH=/data/workspace/projects-dev
